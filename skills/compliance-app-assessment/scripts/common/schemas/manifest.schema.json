{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bundle/manifest.json",
  "type": "object",
  "required": [
    "schema_version",
    "connector",
    "collected_at",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "connector": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the data came from, e.g. an instance URL or export folder"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "bytes",
          "kind",
          "title",
          "obtained"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(EV-[0-9]{4,}|PO-[a-z0-9-]+|SY-[a-z0-9-]+)$"
          },
          "path": {
            "type": "string",
            "description": "Relative to bundle/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "evidence",
              "policy",
              "population",
              "controls",
              "system",
              "soa",
              "isms",
              "context"
            ]
          },
          "title": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Control IDs this artifact was provided for"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Requirement IDs of the audited framework (CC6.1, A.5.18, Art.32(1), Art.21(2)(a)) the source linked this artifact to"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date the artifact itself refers to, when known"
          },
          "source_ref": {
            "type": "string",
            "description": "Identifier in the source system"
          },
          "obtained": {
            "enum": [
              "direct",
              "captured",
              "client",
              "inquiry"
            ],
            "description": "How strong the evidence is. direct: pulled by a connector script from the system of record; captured: pulled by the agent through an MCP server or a read-only CLI command, with the call recorded; client: an export, screenshot or file the organization provided; inquiry: the organization's answer to a question"
          },
          "capture": {
            "type": "object",
            "description": "For captured evidence: how it was obtained (via, server, tool, args, command, at, by, recipe)"
          }
        }
      }
    }
  }
}
